# --- LLM -----------------------------------------------------------------
# Easiest: leave these blank and paste ANY provider key in Settings (admin only).
# The provider, endpoint and model are detected and verified from the key.
# The persona is identical on every provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional local engine
ELOISE_ENABLE_LOCAL=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Accounts ------------------------------------------------------------
# The first real account becomes admin; or name the admin explicitly:
ELOISE_ADMIN_EMAIL=
# Public base URL (used in verification emails)
ELOISE_PUBLIC_URL=
# Set to 1 only when behind a reverse proxy that sets X-Forwarded-For
ELOISE_TRUST_PROXY=0
# Used for users who haven't synced a browser timezone yet
ELOISE_DEFAULT_TZ=UTC

# --- Email (optional) ----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- Runtime -------------------------------------------------------------
ELOISE_STORAGE_DIR=./storage
ELOISE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ELOISE_PLAN_WORKERS=3
ELOISE_LLM_CONCURRENCY=8
ELOISE_DOCS=0
HOST=127.0.0.1
PORT=8000

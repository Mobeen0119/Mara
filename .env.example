SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=youraddress@gmail.com

# Local LLM — huihui_ai/dolphin3-abliterated:latest (uncensored, use for chat)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/dolphin3-abliterated:latest

# Optional cloud fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Storage
ELOISE_STORAGE_DIR=

# CORS — comma-separated origins
ELOISE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Port for the app
PORT=8000
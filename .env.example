# --- LLM -----------------------------------------------------------------
# EASIEST: skip this section and paste your key in the app (Settings -> LLM Provider).
# OR put ONE key here; it is detected, verified and saved on first start.
# Any of these work (use whichever matches your key):
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=  OPENROUTER_API_KEY=  GROQ_API_KEY=  MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=  XAI_API_KEY=  TOGETHER_API_KEY=  OPENAI_API_KEY=
# or the generic one, for any provider:
LLM_API_KEY=
# Optional overrides (normally leave blank, they are detected):
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
# Gemini defaults, for reference:
#   base url  https://generativelanguage.googleapis.com/v1beta/openai
#   model     gemini-3.5-flash-lite
# A key saved in Settings always wins over these.
# Optional local engine
ELOISE_ENABLE_LOCAL=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Accounts ------------------------------------------------------------
# The first real account becomes admin; or name the admin explicitly:
ELOISE_ADMIN_EMAIL=
# Public base URL (used in verification emails)
ELOISE_PUBLIC_URL=
# Set to 1 only when behind a reverse proxy that sets X-Forwarded-For
ELOISE_TRUST_PROXY=0
# Used for users who haven't synced a browser timezone yet
ELOISE_DEFAULT_TZ=UTC

# --- Email (optional) ----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Runtime -------------------------------------------------------------
ELOISE_STORAGE_DIR=./storage
ELOISE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ELOISE_PLAN_WORKERS=3
ELOISE_LLM_CONCURRENCY=8
ELOISE_DOCS=0
HOST=127.0.0.1
PORT=8000
